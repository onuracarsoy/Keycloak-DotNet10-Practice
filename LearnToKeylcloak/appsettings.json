{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeycloakConfiguration": {
    "Hostname": "http://localhost:8080",
    "ClientId": "myclient",
    "Realm": "myrealm",
    "ClientSecret": "YOUR_SECRET_KEY",
    "ClientUUID": "YOUR_CLİENT_UUID"
  },
  "Keycloak": {
    "realm": "myrealm",
    "auth-server-url": "http://localhost:8080/",
    "ssl-required": "none",
    "resource": "myclient",
    "verify-token-audience": false,
    "credentials": {
      "secret": "YOUR_SECRET_KEY"
    },
    "confidential-port": 0,
    "policy-enforcer": {
      "credentials": {}
    }
  }
}
